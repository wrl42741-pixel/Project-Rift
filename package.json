{
  "name": "project-rift-launcher",
  "version": "1.0.0",
  "description": "",
  "main": "electron-main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "pkg": "^5.8.1"
  },
  "bin": {
    "projectrift": "server.js"
  },
  "build": {
    "appId": "com.projectrift",
    "productName": "Project Rift Launcher",
    "files": [
      "electron-main.js",
      "launcher/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Project Rift Setup.exe",
      "shortcutName": "Project Rift Launcher",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "productName": "Project Rift Launcher"
}
